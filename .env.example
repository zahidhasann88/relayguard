# Required, and refused as a placeholder whenever DJANGO_DEBUG is off. Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# With DJANGO_DEBUG=1 an ephemeral key is generated per process instead.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=UTC

# Database
DB_NAME=relayguard_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# Cache, rate limiter and Celery broker
# Leave REDIS_URL empty to use the process-local cache (development only).
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
# Defaults to CELERY_BROKER_URL when empty.
CELERY_RESULT_BACKEND=
CELERY_TASK_TIME_LIMIT=60
# How long a log entry may wait for the broker before the local writer takes over.
CELERY_BROKER_CONNECTION_TIMEOUT=2
# Run tasks inline instead of dispatching them. Development only.
CELERY_TASK_ALWAYS_EAGER=0

# Gateway
PROXY_UPSTREAM=https://httpbin.org
PROXY_ALLOWED_HOSTS=httpbin.org
PROXY_TIMEOUT_SECONDS=15
PROXY_MAX_BODY_BYTES=10485760
PROXY_MAX_RESPONSE_BYTES=26214400

# API keys and retention
MAX_API_KEYS_PER_USER=20
# Age at which an issued key stops authenticating. 0 disables expiry.
API_KEY_MAX_AGE_DAYS=365
API_KEY_CACHE_SECONDS=60
REQUEST_LOG_RETENTION_DAYS=90

#TLS / reverse proxy
SECURE_SSL_REDIRECT=0
USE_X_FORWARDED_PROTO=0
CSRF_TRUSTED_ORIGINS=

# Container runtime (read by docker/entrypoint.sh)
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=30
